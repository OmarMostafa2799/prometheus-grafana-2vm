    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['10.20.1.13:9100']
        labels:
          instance: 'worker-1'

      - targets: ['10.20.1.14:9100']
        labels:
          instance: 'worker-2'



